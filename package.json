{
  "name": "gameshelf",
  "productName": "GameShelf",
  "version": "0.3.3",
  "description": "All your PC games from every launcher, on one shelf.",
  "author": "deadalley",
  "license": "MIT",
  "repository": "github:deadalley/game-shelf",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "preview:mock": "node scripts/dev-mock.mjs --preview",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "fixtures": "vite-node scripts/make-fixtures.ts .fixtures/machine",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/press-start-2p": "5.2.5",
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "4.0.1",
    "framer-motion": "12.43.0",
    "lucide-react": "0.525.0",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.4",
    "zustand": "5.0.6"
  }
}
